  margin-bottom: 14px;
}
.step h3 {
  font-family: 'Playfair Display', serif;
  margin-bottom: 8px;
  font-size: 1.05rem;
}
.step p { font-size: 0.85rem; color: var(--text-soft); }
.step-arrow {
  font-size: 1.8rem;
  color: var(--border);
  font-weight: 300;
