  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  color: var(--text-soft);
  font-size: 0.88rem;
  border: 2px dashed var(--border);
}
.why-img-placeholder span { font-size: 2.4rem; color: var(--primary); }

/* ============================================================
   HOW IT WORKS
   ============================================================ */
.how-it-works {
  background: var(--surface);
  padding: 96px 0;
  border-top: 1px solid var(--border);
}
.steps-grid {
