       { label: "Small",  image: "images/small.jpg" },
       { label: "Medium", image: "images/medium.jpg" }
     ]

   MULTIPLE IMAGES per variant (carousel with arrows):
     colors: [
       { hex: "#D4AF37", name: "Gold",  images: ["gold-1.jpg", "gold-2.jpg", "gold-3.jpg"] },
       { hex: "#FF6B9D", name: "Pink",  images: ["pink-1.jpg", "pink-2.jpg"] }
     ]
     sizes: [
       { label: "Small",  images: ["small-front.jpg", "small-side.jpg"] },
       { label: "Medium", images: ["medium-front.jpg", "medium-back.jpg"] }
     ]

   Mix & match any format per product. Add unlimited colors/sizes/images.
   ---------------------------------------------------------- */

function normalizeColors(colors) {
  if (!colors || !colors.length) return [];
  return colors.map(c => {
    if (typeof c === 'string') return { hex: c, name: c, images: [] };
    const imgs = c.images || (c.image ? [c.image] : []);
    return { hex: c.hex || '#ccc', name: c.name || c.hex, images: imgs };
  });
}

function normalizeSizes(sizes) {
  if (!sizes || !sizes.length) return [];
  return sizes.map(s => {
    if (typeof s === 'string') return { label: s, images: [] };
    const imgs = s.images || (s.image ? [s.image] : []);
    return { label: s.label || '', images: imgs };
  });
}

function buildCarouselHTML(images, emoji, colorHex) {
  if (!images || images.length === 0) {
    const bg = colorHex ? `style="background:${colorHex}"` : '';
    const cls = colorHex ? 'prod-placeholder prod-placeholder--colored' : 'prod-placeholder';
    return `<div class="${cls}" ${bg}><span>${emoji}</span></div>`;
  }
  if (images.length === 1) {
    return `<img src="${images[0]}" alt="Product" loading="lazy" />`;
  }
  const slides = images.map((src, i) =>
    `<img src="${src}" alt="Product photo ${i + 1}" loading="lazy"
          class="carousel-slide${i === 0 ? ' active' : ''}" data-slide-idx="${i}" />`
  ).join('');
  const dots = images.map((_, i) =>
    `<span class="carousel-dot${i === 0 ? ' active' : ''}" data-dot-idx="${i}"></span>`
  ).join('');
  return `
    <div class="prod-carousel" data-current="0" data-total="${images.length}">
      ${slides}
      <button class="carousel-arrow carousel-prev" aria-label="Previous image">\u2039</button>
      <button class="carousel-arrow carousel-next" aria-label="Next image">\u203a</button>
      <div class="carousel-dots">${dots}</div>
    </div>`;
}

function updateProductImage(card, images, colorHex, emoji) {
  const wrap = card.querySelector('.prod-img-wrap');
  wrap.innerHTML = buildCarouselHTML(images, emoji, colorHex);
  initCarouselInCard(card);
}

function initCarouselInCard(card) {
  const carousel = card.querySelector('.prod-carousel');
  if (!carousel) return;
  const total = parseInt(carousel.dataset.total);
  const goTo = (idx) => {
    carousel.dataset.current = idx;
    carousel.querySelectorAll('.carousel-slide').forEach(sl => {
      sl.classList.toggle('active', parseInt(sl.dataset.slideIdx) === idx);
    });
    carousel.querySelectorAll('.carousel-dot').forEach(d => {
      d.classList.toggle('active', parseInt(d.dataset.dotIdx) === idx);
    });
  };
  carousel.querySelector('.carousel-prev')?.addEventListener('click', (e) => {
    e.stopPropagation();
    goTo((parseInt(carousel.dataset.current) - 1 + total) % total);
  });
  carousel.querySelector('.carousel-next')?.addEventListener('click', (e) => {
    e.stopPropagation();
    goTo((parseInt(carousel.dataset.current) + 1) % total);
  });
  carousel.querySelectorAll('.carousel-dot').forEach(dot => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation();
      goTo(parseInt(dot.dataset.dotIdx));
    });
  });
}

function openProductModal(item) {
  const overlay  = document.getElementById('product-modal');
  const waCustom = `https://wa.me/91XXXXXXXXXX?text=${encodeURIComponent(item.waMsg)}`;
  const subtitle = item.desc || (item.tags ? item.tags.join(' \u00b7 ') : '');

  document.getElementById('modal-emoji').textContent    = item.emoji;
  document.getElementById('modal-title').textContent    = item.name;
  document.getElementById('modal-subtitle').textContent = subtitle;

  const customLink = overlay.querySelector('.modal-custom-link');
  if (customLink) customLink.href = waCustom;

  const productsEl = document.getElementById('modal-products');

  if (!item.products || item.products.length === 0) {
    productsEl.innerHTML = `
      <div class="modal-empty">
        <p>Products coming soon! Chat with us to find out what's available.</p>
        <a href="${waCustom}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>`;
  } else {
    productsEl.innerHTML = item.products.map((prod, pIdx) => {
      const waUrl = `https://wa.me/91XXXXXXXXXX?text=${encodeURIComponent(prod.waMsg)}`;
      const colors = normalizeColors(prod.colors);
      const sizes  = normalizeSizes(prod.sizes);

      // Default images: product.images > product.image > first color's images > empty
      let defaultImages = [];
      if (prod.images && prod.images.length) {
        defaultImages = prod.images;
      } else if (prod.image) {
        defaultImages = [prod.image];
      } else if (colors.length && colors[0].images.length) {
        defaultImages = colors[0].images;
      }

      const defaultHex = colors.length ? colors[0].hex : null;
      const imgHTML = buildCarouselHTML(defaultImages, item.emoji, defaultHex);

      const colorHTML = colors.length
        ? `<div class="prod-colors">${colors.map((c, cIdx) =>
            `<span class="color-swatch${cIdx === 0 ? ' active' : ''}"
                   style="background:${c.hex}"
                   title="${c.name}"
                   data-color-hex="${c.hex}"
                   data-color-images='${JSON.stringify(c.images)}'
                   role="button" tabindex="0"
                   aria-label="Select color ${c.name}"></span>`
          ).join('')}</div>`
        : '';

      const sizeHTML = sizes.length
        ? `<div class="prod-sizes">${sizes.map((s, sIdx) =>
            `<span class="size-chip${sIdx === 0 ? ' active' : ''}"
                   data-size-images='${JSON.stringify(s.images)}'
                   role="button" tabindex="0"
                   aria-label="Select size ${s.label}">${s.label}</span>`
          ).join('')}</div>`
        : '';

      return `
        <div class="prod-card" data-prod-idx="${pIdx}" data-emoji="${item.emoji}">
          <div class="prod-img-wrap">${imgHTML}</div>
          <div class="prod-body">
            <h4>${prod.name}</h4>
            <div class="prod-price">${prod.price}</div>
            ${colorHTML}
            ${sizeHTML}
            <a class="prod-wa-btn" href="${waUrl}" target="_blank" rel="noopener noreferrer">
              <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/whatsapp.svg" alt="" />
              Order on WhatsApp
            </a>
          </div>
        </div>`;
    }).join('');

    // Init carousels
    productsEl.querySelectorAll('.prod-card').forEach(card => initCarouselInCard(card));

    // Color swatch click → switch carousel images
    productsEl.querySelectorAll('.color-swatch').forEach(swatch => {
      swatch.addEventListener('click', () => {
        const card   = swatch.closest('.prod-card');
        const emoji  = card.dataset.emoji;
        const hex    = swatch.dataset.colorHex;
        const images = JSON.parse(swatch.dataset.colorImages || '[]');

        card.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        updateProductImage(card, images, hex, emoji);
      });
    });

    // Size chip click → switch carousel images
    productsEl.querySelectorAll('.size-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const card   = chip.closest('.prod-card');
        const emoji  = card.dataset.emoji;
        const images = JSON.parse(chip.dataset.sizeImages || '[]');

        card.querySelectorAll('.size-chip').forEach(s => s.classList.remove('active'));
        chip.classList.add('active');

        if (images.length) {
          const activeColor = card.querySelector('.color-swatch.active');
          const hex = activeColor ? activeColor.dataset.colorHex : null;
          updateProductImage(card, images, hex, emoji);
        }
      });
    });
    // Image click → open lightbox (ignore clicks on carousel arrows/dots)
    productsEl.querySelectorAll('.prod-img-wrap').forEach(wrap => {
      // Add zoom button
      const zoomBtn = document.createElement('button');
      zoomBtn.className = 'prod-zoom-btn';
      zoomBtn.innerHTML = '&#x1F50D;';
      zoomBtn.setAttribute('aria-label', 'View full size');
      zoomBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        handleImageClick(wrap);
      });
      wrap.appendChild(zoomBtn);
    });
  }

  overlay.classList.add('open');
  overlay.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  setTimeout(() => document.getElementById('modal-close').focus(), 80);
}

function openModal(catIndex) {
  openProductModal(CATEGORIES[catIndex]);
}

function openOccasionModal(occIndex) {
  openProductModal(OCCASIONS[occIndex]);
}

function closeModal() {
  const overlay = document.getElementById('product-modal');
  overlay.classList.remove('open');
  overlay.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

function initModal() {
  const overlay = document.getElementById('product-modal');
  if (!overlay) return;
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      if (document.getElementById('lightbox').classList.contains('open')) closeLightbox();
      else if (overlay.classList.contains('open')) closeModal();
    }
  });
}

/* ---- Lightbox (full-screen image viewer) ------------------ */
let lbImages = [];
let lbCurrent = 0;

function openLightbox(images, startIdx) {
  if (!images || images.length === 0) return;
  lbImages = images;
  lbCurrent = startIdx || 0;
  renderLightbox();
  const lb = document.getElementById('lightbox');
  lb.classList.add('open');
  lb.setAttribute('aria-hidden', 'false');
}

function closeLightbox() {
  const lb = document.getElementById('lightbox');
  lb.classList.remove('open');
  lb.setAttribute('aria-hidden', 'true');
}

function renderLightbox() {
  const wrap = document.getElementById('lightbox-img');
  const counter = document.getElementById('lightbox-counter');
  const dotsEl = document.getElementById('lightbox-dots');

  wrap.innerHTML = `<img src="${lbImages[lbCurrent]}" alt="Product photo ${lbCurrent + 1}" />`;
  counter.textContent = `${lbCurrent + 1} / ${lbImages.length}`;

  if (lbImages.length > 1) {
    dotsEl.innerHTML = lbImages.map((_, i) =>
      `<span class="lightbox-dot${i === lbCurrent ? ' active' : ''}" data-lb-idx="${i}"></span>`
    ).join('');
    dotsEl.querySelectorAll('.lightbox-dot').forEach(dot => {
      dot.addEventListener('click', () => { lbCurrent = parseInt(dot.dataset.lbIdx); renderLightbox(); });
    });
  } else {
    dotsEl.innerHTML = '';
  }
}

function initLightbox() {
  const lb = document.getElementById('lightbox');
  if (!lb) return;
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
  document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev').addEventListener('click', () => {
    lbCurrent = (lbCurrent - 1 + lbImages.length) % lbImages.length;
    renderLightbox();
  });
  document.getElementById('lightbox-next').addEventListener('click', () => {
    lbCurrent = (lbCurrent + 1) % lbImages.length;
    renderLightbox();
  });
}

/* Opens lightbox from a product card's image area */
function handleImageClick(wrap) {
  // Gather current image URLs from the carousel or single image
  const carousel = wrap.querySelector('.prod-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll('.carousel-slide');
    const images = Array.from(slides).map(s => s.src);
    const current = parseInt(carousel.dataset.current) || 0;
    openLightbox(images, current);
  } else {
    const img = wrap.querySelector('img');
    if (img) openLightbox([img.src], 0);
  }
}

/* ---- Render Footer Category Links ------------------------- */
function buildFooterCategories() {
  const ul = document.getElementById('footer-cats');
  if (!ul) return;
  // Show first 7 in footer
  ul.innerHTML = CATEGORIES.slice(0, 7).map(cat =>
    `<li><a href="#categories">${cat.name}</a></li>`
  ).join('');
}

/* ---- Navbar Scroll Effect --------------------------------- */
function initNavbar() {
  const navbar = document.getElementById('navbar');
  const onScroll = () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
}

/* ---- Mobile Hamburger Menu -------------------------------- */
function initHamburger() {
  const btn = document.getElementById('hamburger');
  const links = document.querySelector('.nav-links');
  if (!btn || !links) return;

  btn.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });

  // Close on link click
  links.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
}

/* ---- Scroll Reveal Animation ------------------------------ */
function initScrollReveal() {
  const targets = document.querySelectorAll(
    '.cat-card, .occ-card, .strip-item, .step, .contact-card, .why-text, .why-image'
  );

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  targets.forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(28px)';
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    observer.observe(el);
  });
}

/* ---- Init ------------------------------------------------- */
document.addEventListener('DOMContentLoaded', () => {
  buildOccasionCards();
  buildCategoryCards();
  buildFooterCategories();
  initNavbar();
  initHamburger();
  initScrollReveal();
  initModal();
  initLightbox();
});


