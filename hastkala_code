.contact-card:hover {
  background: rgba(255,255,255,0.14);
  transform: translateY(-4px);
}
.cc-icon {
  font-size: 2.4rem;
  margin-bottom: 14px;
}
.contact-card h3 {
  font-family: 'Playfair Display', serif;
