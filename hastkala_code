/* ---- Render Occasion Cards -------------------------------- */
function buildOccasionCards() {
  const grid = document.getElementById('occ-grid');
  if (!grid) return;

  grid.innerHTML = OCCASIONS.map((occ, index) => {
    const tagsHTML = occ.tags.map(t => `<span class="occ-tag">${t}</span>`).join('');
    const count = occ.products ? occ.products.length : 0;
    const label = count > 0 ? `View ${count} Gift Ideas →` : 'Explore →';

    return `
      <div class="occ-card" style="--occ-grad: ${occ.color}"
           onclick="openOccasionModal(${index})"
           role="button" tabindex="0"
           aria-label="View ${occ.name} gift ideas"
           onkeydown="if(event.key==='Enter'||event.key===' ')openOccasionModal(${index})">
        <div class="occ-inner">
          <div class="occ-emoji">${occ.emoji}</div>
          <h3>${occ.name}</h3>
          <div class="occ-tags">${tagsHTML}</div>
          <span class="occ-btn">${label}</span>
        </div>
      </div>`;
  }).join('');
}

/* ---- Render Category Cards -------------------------------- */
function buildCategoryCards() {
  const grid = document.getElementById('cat-grid');
  if (!grid) return;

  grid.innerHTML = CATEGORIES.map((cat, index) => {
    const imageHTML = cat.image
      ? `<img src="${cat.image}" alt="${cat.name}" loading="lazy" />`
      : `<div class="cat-placeholder">
           <span class="cat-emoji">${cat.emoji}</span>
           <p>Image coming soon</p>
         </div>`;

    const badgeHTML = cat.badge
      ? `<div class="cat-badge">${cat.badge}</div>`
      : '';

    const count = cat.products ? cat.products.length : 0;
    const label = count > 0 ? `${count} Products` : 'View Details';

    return `
      <div class="cat-card"
           onclick="openModal(${index})"
           role="button" tabindex="0"
           aria-label="View ${cat.name} products"
           onkeydown="if(event.key==='Enter'||event.key===' ')openModal(${index})">
        <div class="cat-img-wrap">
          ${imageHTML}
          ${badgeHTML}
        </div>
        <div class="cat-body">
          <h3>${cat.name}</h3>
          <p>${cat.desc}</p>
          <div class="cat-footer">
            <span class="cat-price">${cat.priceRange}</span>
            <span class="cat-view-btn">${label} →</span>
          </div>
        </div>
      </div>`;
  }).join('');
}

