}
.occ-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}
.occ-tag {
  font-size: 0.7rem;
  font-weight: 500;
  background: rgba(255,255,255,0.22);
  color: #fff;
  padding: 3px 10px;
  border-radius: 50px;
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.3);
}
.occ-btn {
  margin-top: auto;
  font-size: 0.82rem;
  font-weight: 600;
  color: #fff;
  background: rgba(255,255,255,0.2);
  border: 1px solid rgba(255,255,255,0.45);
  padding: 8px 18px;
  border-radius: 50px;
  transition: background var(--transition);
  backdrop-filter: blur(4px);
}
.occ-btn:hover {
  background: rgba(255,255,255,0.35);
}

/* ============================================================
   CATEGORIES
   ============================================================ */
.categories {
  padding: 96px 0;
  background: var(--bg);
}
.cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 28px;
}
.cat-card {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.05);
  transition: transform var(--transition), box-shadow var(--transition);
  cursor: pointer;
  position: relative;
}
.cat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px var(--shadow);
}
.cat-img-wrap {
  width: 100%;
  height: 200px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--bg-alt), var(--border));
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.cat-card:hover .cat-img-wrap img {
  transform: scale(1.07);
}
.cat-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%; height: 100%;
  gap: 10px;
}
.cat-placeholder .cat-emoji { font-size: 3rem; }
.cat-placeholder p {
  font-size: 0.78rem;
  color: var(--text-soft);
  letter-spacing: 0.5px;
}
.cat-badge {
  position: absolute;
  top: 12px; right: 12px;
  background: var(--accent);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 50px;
  letter-spacing: 0.5px;
}
.cat-body {
  padding: 18px 20px 22px;
}
.cat-body h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.1rem;
  margin-bottom: 6px;
}
.cat-body p {
  font-size: 0.83rem;
  color: var(--text-soft);
  margin-bottom: 14px;
}
.cat-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cat-price {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--primary);
}
.cat-wa-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--wa-green);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 7px 14px;
  border-radius: 50px;
  transition: var(--transition);
}
.cat-wa-btn:hover { background: #1ebe5a; }
.cat-wa-btn img {
  width: 14px; height: 14px;
  filter: invert(1) brightness(2);
  display: inline-block;
}

/* ============================================================
   WHY US
   ============================================================ */
.why-us {
  background: var(--bg-alt);
  padding: 96px 0;
  border-top: 1px solid var(--border);
}
.why-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.why-text .section-tag { display: block; text-align: left; }
.why-text h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  margin-bottom: 18px;
  text-align: left;
}
.why-text p {
  color: var(--text-soft);
  margin-bottom: 28px;
  font-size: 0.95rem;
}
.why-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 36px;
}
.why-list li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.92rem;
}
.why-list li span {
  width: 24px; height: 24px;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  flex-shrink: 0;
}
.why-delivery-note {
  font-size: 0.88rem;
  color: var(--text-soft);
  background: var(--bg);
  border-left: 3px solid var(--accent);
  padding: 12px 16px;
  border-radius: 0 8px 8px 0;
