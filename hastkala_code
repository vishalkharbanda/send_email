/* ============================================================
   CONTACT
   ============================================================ */
.contact {
  background: linear-gradient(135deg, #3D0C1A 0%, #6B1A2E 50%, #C8506A 100%);
  padding: 96px 0;
}
.contact .section-tag { color: var(--accent); }
.contact .section-head h2 { color: #fff; }
.contact .section-sub { color: rgba(255,255,255,0.7); }
